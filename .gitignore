# Build outputs
build/
compile_commands.json

# Third-party build/install byproducts (sources are submodules, see third_party/VERSIONS)
third_party/sleigh-install/
*.log

# larl: secrets and proprietary, prepatched test inputs stay build-local
larl/local.properties
larl/versions_test/
larl/.gradle/
larl/build/
larl/app/build/

# Game inputs and extracted assets are never committed
*.obb
*.apk
games/*/inputs/

# Commit-pinned dependencies are provisioned by tools/bootstrap.sh.
third_party/emsdk/
third_party/sleigh/
third_party/ghidra*/
__pycache__/
*.pyc
*.so
*.dll
*.exe
generated/
